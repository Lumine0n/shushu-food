page { background: #f8f4ea; color: #292821; font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif; }
.page { padding: 56rpx 40rpx 160rpx; }
.eyebrow { color: #bb523d; font-size: 24rpx; font-weight: 700; letter-spacing: 4rpx; }
.title { margin: 18rpx 0; font-family: "Songti SC", serif; font-size: 64rpx; line-height: 1.1; font-weight: 700; }
.muted { color: #777267; line-height: 1.7; }
.card { margin-top: 40rpx; padding: 36rpx; border: 1rpx solid #ddd5c7; border-radius: 28rpx; background: rgba(255,255,255,.58); }
.button { margin-top: 32rpx; border-radius: 999rpx; background: #b84e39; color: white; font-weight: 700; }
.food { margin-top: 24rpx; padding: 28rpx; border-radius: 24rpx; background: white; }
.food-name { font-size: 36rpx; font-weight: 700; }
.food-meta { margin-top: 10rpx; color: #777267; font-size: 24rpx; }
